# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_aman
POSTGRES_DB=wastrajaga
DATABASE_URL=postgresql://postgres:ganti_dengan_password_aman@db:5432/wastrajaga

# Auth.js (NextAuth v5) Secret
AUTH_SECRET=ganti_dengan_random_secret_32_karakter
# Diperlukan agar Auth.js mempercayai host di balik reverse proxy / Docker
AUTH_TRUST_HOST=true
# URL publik aplikasi (ubah ke domain Anda saat deploy)
AUTH_URL=http://localhost:3000

# Vision LLM Provider
# Pilih: mock | gemini | openai | anthropic
# "mock" bisa dijalankan tanpa API key (untuk demo juri)
LLM_PROVIDER=mock

# API Keys (isi sesuai provider yang dipakai, jangan commit nilai asli)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Token autentikasi kamera (server-side, rahasia)
CAMERA_API_TOKEN=ganti_dengan_token_kamera_aman

# Token kamera untuk sisi klien (browser) — boleh public karena hanya untuk demo
# Harus sama dengan CAMERA_API_TOKEN di atas
NEXT_PUBLIC_CAMERA_API_TOKEN=ganti_dengan_token_kamera_aman

# Cloudflare Tunnel (Opsional, isi jika menggunakan Cloudflare Tunnel untuk publikasi)
# Jalankan dengan: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Konfigurasi Server
PORT=3000
HOSTNAME=0.0.0.0
