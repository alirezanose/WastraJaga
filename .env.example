# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_aman
POSTGRES_DB=wastrajaga
DATABASE_URL=postgresql://postgres:ganti_dengan_password_aman@db:5432/wastrajaga

# Cloudflare Tunnel (Opsional, isi jika menggunakan Cloudflare Tunnel untuk publikasi)
# Jalankan dengan: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Konfigurasi Server
PORT=3000
HOSTNAME=0.0.0.0
